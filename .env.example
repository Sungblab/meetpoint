# 영문과 숫자로만 만든 긴 비밀번호. 예: openssl rand -hex 24
POSTGRES_PASSWORD=

# 비워두면 AI 없이 키워드 기반 추천만 쓰고 명함 읽기는 꺼진다.
GEMINI_API_KEY=

# 운영자 화면(/admin) 비밀번호. 비워두면 운영자 화면이 꺼진다. 예: openssl rand -hex 24
ADMIN_PASSWORD=

# 방을 만들면 관리 주소를 주최자 이메일로 보낸다. SMTP_HOST를 비워두면 보내지 않는다.
# Resend: SMTP_HOST=smtp.resend.com, SMTP_USER=resend, SMTP_PASSWORD=발송 권한만 준 API 키,
# MAIL_FROM=Resend에서 인증한 도메인의 주소(예: noreply@sungblab.com). Resend는 MAIL_FROM이 꼭 있어야 한다.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# 보내는 주소. 비워두면 SMTP_USER
MAIL_FROM=

# QR과 공유 링크에 들어갈 주소
PUBLIC_BASE_URL=https://meetpoint.example.com

# 서버 안에서 Nginx가 붙을 포트. 다른 앱과 겹치지 않게 고른다.
APP_PORT=8010

# 선택 설정
# AI_MODEL=gemini-3.8-flash
# AI_EFFORT=low
# AI_CONCURRENCY=6
# AI_DAILY_LIMIT=10000
# AI_ROOM_DAILY_LIMIT=3000
# AI_CARD_EFFORT=low
# AI_BATCH_SIZE=20
# MAX_PARTICIPANTS=300
